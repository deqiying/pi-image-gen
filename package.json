{
  "name": "@deqiying/pi-image-gen",
  "version": "0.1.7",
  "private": false,
  "type": "module",
  "description": "Native pi agent image generation and editing through OpenAI-compatible Images APIs.",
  "license": "Apache-2.0",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "image-generation",
    "images-api",
    "openai-compatible"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deqiying/pi-image-gen.git"
  },
  "homepage": "https://github.com/deqiying/pi-image-gen#readme",
  "bugs": {
    "url": "https://github.com/deqiying/pi-image-gen/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/image-generation/*.test.ts src/index.integration.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.85.1",
    "@earendil-works/pi-ai": ">=0.85.1",
    "@earendil-works/pi-coding-agent": ">=0.85.1",
    "@earendil-works/pi-tui": ">=0.85.1"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.85.1",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
